#
# Frankel sensor device configuration registry script for the DVT stage and after.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x30000:0xFFFF0000
# Exclude
?-0x32000:0xFFFFF000  # Proto
?-0x33000:0xFFFFF000  # EVT

#
# Record reg_script.
#

+/
reg_script=frankel_dvt.reg

#
# Sensors
#
+/dev/mmc5616/0/mag
  fac_cal_transform=0.9917 0.0775 0.0266 0.1047 0.9454 0.0228 -0.0045 0.0273 1.0877 0.0 0.0 0.0
  curr_comp_factors_fast=4.39 2.71 8.13
  curr_comp_factors=8.34 5.14 17.49

# ALSP (TMD3743)
+/dev/tmd3743/0/als
  x_scale=1.163
  lux_scale=1.156
  z_scale=1.175
  x_crgbw_coefs=-37.408235 43.854591 129.513772 -9.300066 -2.601188
  lux_crgbw_coefs=-27.257599 26.672212 124.899590 0.132850 -1.952329
  z_crgbw_coefs=30.456540 -57.486146 -0.813766 132.762996 1.365894

+/dev/tmd3743/0/panel-b/als
  x_scale=1.134
  lux_scale=1.111
  z_scale=1.043

+/dev/tmd3743/0/prox
  gain1=128
  gain2=1
  pulse_count=2
  pulse_len_us=32

# RAINBOW (VD6282)
+/dev/vd6282/0/spectral
  # Golden values for calibration.
  golden_rals_r=949.962890625
  golden_rals_g=1079.128125
  golden_rals_b=284.522265625
  golden_rals_clr1=4741.81679688
  golden_rals_ir=2967.23828125
  golden_rals_clr2=4705.859375

+/dev/vd6282/0/rls
  lux_scale=113.528095
