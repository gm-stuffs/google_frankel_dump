  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240.0000 137.17 93.21 41.86 13.07 134.55 1180.0000 240.0000 85.90 62.10 27.55 12.29 84.90 3826.0000

+/dev/tmd3743/0/spectral
  priority=1

+/dev/tmd3743/0/color
  filter_size=100
  on_change_delta=150

# Display Info
+/dev/display_info/0
