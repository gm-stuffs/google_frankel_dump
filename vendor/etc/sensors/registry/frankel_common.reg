# BARO (SPL07003)
+/dev/spl07003/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x77
  intr_id=20
  intr_gpio_id=85
+/dev/spl07003/0/baro
  fac_cal_transform=1.0 -0.14627
  temp=25.52
  temp_sensitivity=0.00032
  name=SPL07003 Barometer
+/dev/spl07003/0/temp
