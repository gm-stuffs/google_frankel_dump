  #                n = DBV equation count.
  # The DBV-term equation applies for the given pwm_hz, for the given leakage channel,
  # when "start_DBV <= current_DBV <= end_DBV".
  histo_dbv_eq_240_0_0=0 0 0 0
  histo_dbv_eq_240_0_1=1 1180 0 0.29766227408228346 0.0010559702520526256 -3.3531358642765027e-06 1.1100110754182417e-08 -1.7394994876539e-11 1.2410970915276e-14 -3.2581121494660195e-18
  histo_dbv_eq_240_0_2=1181 4096 0 -24.20758826794742 0.07330166992602459 -8.825396642635291e-05 5.423276443351323e-08 -1.788634725346804e-11 3.0152810038953377e-15 -2.0408017738611502e-19
  histo_dbv_eq_240_1_0=0 0 0 0
