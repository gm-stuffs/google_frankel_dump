#
# Frankel sensor device configuration registry script for all stages.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x30000:0xFFFF0000

#
# Buses
#

# I2C
+/dev/i2c/2
  bus_name=i2c2
  bus_index=2

# I3C
+/dev/i3c/0
  bus_name=i3c0
  bus_index=0
+/dev/i3c/4
  bus_name=i3c4
  bus_index=4

# SPI
+/dev/spi/3
  bus_name=spi3
  bus_index=3

# PDM
+/dev/pdm
  base_clk_hz=38400000

#
# Sensors
#

# ALSP (TMD3743)
+/dev/tmd3743/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=3
  intr_gpio_id=86
  anti_aliasing=1
  interlacing=1
  # Leakage model type to use to calculate display leakage.
  #  0 : Compensate Lux using weighted Luma.
  #  1 : Compensate Lux using legacy plus modified C-channel histogram.
  #  2 : Compensate calculated XYZ values.
  #  3 : Compensate CRGBW channels.
  leakage_model_type=3

+/dev/tmd3743/0/prox
  auto_baseline=1
  temp_coeff=0
  pdata_scale=3.365
  pdata_baseline=6102
  far_threshold=900
  near_threshold=1500
  min_fps=30

+/dev/tmd3743/0/panel-b/prox
  # auto_baseline property is explicitly required on panel-specific node as well.
  auto_baseline=1
  pdata_scale=3.019
  pdata_baseline=6685

+/dev/tmd3743/0/als
  # Display PWM table and dependent parameters.
  pwm_hz=240
  vsync_delay_us=399

  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=791 4096
  itime_table_0=1600000 300000
  max_gain_table_0=7 7
  prox_delay_60hz_0=13800 13800
  prox_delay_120hz_0=6800 6800

  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Alternate Lux equation parameters.
  # Format:
  #   per_chan_lux_coefs = <C_coef> <R_coef> <G_coef> <B_coef> <W_coef>
  #   c_g_ratio_modified_lux = r1 r2 r3 r4
  #      defined as:
  #      (C/G < r1) || (r4 < C/G)            =>  W-based  eq.
  #      (r1 < C/G < r2) || (r3 < C/G < r4)  =>  Weighted average between W-based and default eq.
  #      r2 < C/G < r3                       =>  Default eq.
  per_chan_lux_coefs=30 90 90 90 30
  c_g_ratio_modified_lux=2.4 2.8 4.8 5.2

  # Histogram Configuration.
  histo_enable=1
  # Display coordinates go from top left to bottom right.
  histo_roi_left=350
  histo_roi_top=185
  histo_roi_right=450
  histo_roi_bottom=285
  # The maximum brightness (DBV) value up to which histogram is active.
  # This value should match one of the itime_table_brightness values.
  histo_max_brightness=4096
  # Minimum change needed for a leakage value to be reported, i.e.,
  # min_change = MAX(min_change_value, current_leakage_val * min_change_rate)
  histo_min_change_value=0.5
  histo_min_change_rate=0.01
  # Histogram polling interval in ms.
  histo_polling_interval=50
  # Fallback luma value to use when histogram returns error (e.g., due to DRM).
  histo_fallback_luma=128.0

  ## Leakage calculator configuration.

  # Histo Luma matrix coefficients.
  # Format: histo_luma_matrix_<pwm_hz>_<n> = <start_DBV> <end_DBV> <<co-effs of luma-term matrix>>
  #         where: pwm_hz = PWM frequency; n = Luma matrix count.
  # The luma-term matrix applies for the given pwm_hz, when "start_DBV <= current_DBV <= end_DBV".
  histo_luma_matrix_240_0=0 894 0.29725993 0.6461387 0.05660137 0.480854 0.46925864 0.04988736 -0.16959211 1.12308822 0.04650389 0.26597169 0.71886162 0.01516669 0.38634486 0.58614375 0.02751139
  histo_luma_matrix_240_1=895 4096 0.44603708 0.50862785 0.04533507 0.64097434 0.38917232 -0.03014666 0.15304596 0.76645162 0.08050242 0.29891379 0.4732223 0.22786391 0.53278 0.45449917 0.01272084

  # Histo Luma exponent table.
  # Format: histo_luma_exp = <DBV1 exponent1> <DBV2 exponent2> ... <DBV_n exponent_n>
  #         where: DBV1 < DBV2 < ... < DBV_n.
  # For current_DBV, "exponent_x" value from first pair satisfying "current_DBV <= DBV_x" is chosen.
  histo_luma_exp=894 0.5 4096 0.75

  # Histo DBV equations.
  # Format: histo_dbv_eq_<pwm_hz>_<channel_index>_<n> = <start_DBV> <end_DBV> <eq_type>
  #                                                     <<equation co-efficients>>
  #         where: pwm_hz = PWM freq; channel_index = Leakage channel index enumerated as CRGBW;
  #                n = DBV equation count.
  # The DBV-term equation applies for the given pwm_hz, for the given leakage channel,
  # when "start_DBV <= current_DBV <= end_DBV".
  histo_dbv_eq_240_0_0=0 174 0 0
  histo_dbv_eq_240_0_1=175 791 0 -0.17431774261358896 0.006160547120482671 -1.7559789552545088e-05 -6.646627991672389e-10 9.06182866334224e-11 -1.4784590745894419e-13 7.320964842397042e-17
  histo_dbv_eq_240_0_2=792 4096 0 -1.4638518218830203 0.003507494203812295 -2.7305412245701794e-06 1.005946496354925e-09 -1.4245663686283509e-13 -2.2536357526646203e-18 1.6008008457809311e-21
  histo_dbv_eq_240_1_0=0 174 0 0
  histo_dbv_eq_240_1_1=175 791 0 0.5915244618268878 -0.006314690015163372 6.707503291235117e-05 -2.9102754829156037e-07 6.210747454616862e-10 -6.384123668843666e-13 2.5329560731402224e-16
  histo_dbv_eq_240_1_2=792 4096 0 -0.9539605209191131 0.00195251319152273 -8.889719663217586e-07 -1.1694128377362673e-10 2.2710998544776043e-13 -6.441570155100787e-17 5.791321364530877e-21
  histo_dbv_eq_240_2_0=0 174 0 0
  histo_dbv_eq_240_2_1=175 791 0 -1.0706216616218982 0.017766949724842388 -7.812224652046391e-05 1.590170946843413e-07 -1.3841255506921036e-10 2.424483415217922e-14 1.988536345766835e-17
  histo_dbv_eq_240_2_2=792 4096 0 -2.432773483180557 0.006150477844287667 -5.513788259534016e-06 2.550542745733906e-09 -6.203347523354579e-13 7.532981472380059e-17 -3.537689513870702e-21
  histo_dbv_eq_240_3_0=0 174 0 0
  histo_dbv_eq_240_3_1=175 791 0 0.8442851075391014 -0.011156234309084514 9.499715812180846e-05 -3.7310864600191387e-07 7.46615143390585e-10 -7.316722431419311e-13 2.793147266915753e-16
  histo_dbv_eq_240_3_2=792 4096 0 -1.4468975147430498 0.002954250724228599 -1.5426442705780415e-06 3.7769648501990297e-11 2.3626282164803314e-13 -7.410793701774452e-17 6.91698170331497e-21
  histo_dbv_eq_240_4_0=0 174 0 0
  histo_dbv_eq_240_4_1=175 791 0 -1.383142431593963 0.02437267890770084 -0.00012468112647513692 3.1821607369849984e-07 -4.1737350703351396e-10 2.6405677074331897e-13 -6.01937467548978e-17
  histo_dbv_eq_240_4_2=792 4096 0 -1.403894017591757 0.00345872400728719 -2.88585237200088e-06 1.2204061744212705e-09 -2.4901656572723205e-13 2.1482131943977296e-17 -3.864973719564776e-22

  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240.0000 39.26 23.64 11.03 1.21 37.79 791.0000 240.0000 63.10 43.81 22.24 9.29 69.39 3499.0000

+/dev/tmd3743/0/panel-b/als
  vsync_delay_us=338

  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=1180 4096
  itime_table_0=1600000 300000
  max_gain_table_0=7 7
