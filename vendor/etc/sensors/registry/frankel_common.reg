  histo_dbv_eq_240_2_0=0 0 0 0
  histo_dbv_eq_240_2_1=1 1180 0 0.26521781035418973 0.001632375025782685 -5.922097394901885e-06 1.6345012558347035e-08 -2.2496659055808348e-11 1.458281295982977e-14 -3.542143295663153e-18
  histo_dbv_eq_240_2_2=1181 4096 0 -21.948102552661283 0.06593176782233816 -7.872312419354656e-05 4.8028051739841985e-08 -1.5743739366908658e-11 2.6404470930328746e-15 -1.7789983344038999e-19
  histo_dbv_eq_240_3_0=0 0 0 0
  histo_dbv_eq_240_3_1=1 1180 0 0.2865905399838769 0.0011445931489166873 -3.7694727807226542e-06 1.260182594748292e-08 -2.0089714919734638e-11 1.466051429877721e-14 -3.9694183959382866e-18
  histo_dbv_eq_240_3_2=1181 4096 0 -21.98061836614531 0.06555297820137222 -7.790490538099544e-05 4.7360883959795905e-08 -1.5479394087205888e-11 2.5889162300060677e-15 -1.739352245969574e-19
  histo_dbv_eq_240_4_0=0 0 0 0
  histo_dbv_eq_240_4_1=1 1180 0 0.30471871186808713 0.0008653771382273712 -1.8199538445279753e-06 5.984968127675086e-09 -9.301657742042083e-12 6.399033462120837e-15 -1.5713886711777857e-18
