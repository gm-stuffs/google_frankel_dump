  intr_trigger_type=2
+/dev/camera_vsync/2 # FCAM2AP_VSYNC
  intr_id=59
  intr_trigger_type=2
+/dev/camera_vsync/3 # RTCAM2AP_VSYNC
  intr_id=62
  intr_trigger_type=2

