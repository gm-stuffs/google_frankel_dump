#
# Frankel sensor device configuration registry script for the Proto 1.0 stage.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x32100:0xFFFFFFF0

#
# Record reg_script.
#

+/
reg_script=frankel_proto_1_0.reg

#
# Sensors
#

# MAG 0 (MMC5616WA)
+/dev/mmc5616/0
  priority=0
+/dev/mmc5616/0/mag
  name=MMC5616 Magnetometer 0
  fac_cal_transform=0.9474 0.0579 0.0146 0.1135 0.96 0.0246 0.021 0.0211 1.0744 0.0 0.0 0.0

# MAG 1 (MMC5616WA)
+/dev/mmc5616/1
  bus_name=i3c4
  bus_freq_hz=400000
  i3c_freq_hz=6250000
  bus_addr=0x30
  i3c_addr=0x14
  priority=1
+/dev/mmc5616/1/mag
  orientation_transform=-2 1 3
  name=MMC5616 Magnetometer 1
  fac_cal_transform=0.9312 0.255 -0.0181 0.2463 1.2477 -0.0013 0.5444 -0.1147 1.0483 0.0 0.0 0.0

# ALSP (TMD3743)
+/dev/tmd3743/0/als
  x_scale=21.246
  lux_scale=37.809
  z_scale=33.987
  x_crgbw_coefs=1 -1.012 -0.914 0.925 0.535
  lux_crgbw_coefs=1 -1.034 1.201 -1.167 0.146
  z_crgbw_coefs=1 -2.769 -5.995 7.763 1.116

+/dev/tmd3743/0/prox
  gain1=128
  gain2=1
  pulse_count=4
  pulse_len_us=63

+/dev/tmd3743/0/panel-b/prox
  gain1=64
  gain2=1
  pulse_count=4
  pulse_len_us=125

# RAINBOW (VD6282)
+/dev/vd6282/0/spectral
  # Golden values for calibration.
  golden_rals_r=954.839453125
  golden_rals_g=1102.59609375
  golden_rals_b=279.598828125
  golden_rals_clr1=4750.83789062
  golden_rals_ir=2950.51328125
  golden_rals_clr2=4790.44023437

+/dev/vd6282/0/rls
  lux_scale=111.11173
